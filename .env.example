# Copy this file to .env and fill in your key from https://app.gnani.ai/voice
GNANI_API_KEY=

# Optional: use Prisma v3.0 instead of the default v2.5
# GNANI_STT_MODEL=prisma-v3.0

# Optional: Timbre voices from the voice catalog (docs.gnani.ai)
# GNANI_TTS_VOICE_HI=Nalini
# GNANI_TTS_VOICE_KN=Nalini

# Force demo mode even with a key (scripted calls, no mic)
# KAVACH_MOCK=1
